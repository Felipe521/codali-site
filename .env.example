# Integrações opcionais do site da Codali.
# Copie este arquivo para ".env" e preencha. Depois rode "npm run build".
# Enquanto um campo estiver vazio, o site usa a alternativa descrita ao lado — nunca simula envios.

# Endereço que recebe os formulários (contato, revendedor, representante) via POST JSON.
# Ex.: Formspree  -> https://formspree.io/f/SEU_ID
#      Web3Forms  -> https://api.web3forms.com/submit (preencha também VITE_FORM_ACCESS_KEY)
#      Backend próprio que aceite JSON e responda 2xx.
# Vazio: o botão vira "Enviar pelo WhatsApp" e abre a conversa com os dados já preenchidos.
VITE_FORM_ENDPOINT=

# Chave de acesso exigida por alguns serviços (ex.: Web3Forms). Enviada como "access_key".
VITE_FORM_ACCESS_KEY=

# Caminho ou URL do PDF do catálogo (ex.: /catalogo/catalogo-codali.pdf — coloque o arquivo em public/catalogo/).
# Vazio: a seção de catálogo oferece "Receber catálogo no WhatsApp" e o catálogo digital do site.
VITE_CATALOGO_URL=

# URL da política de privacidade, quando existir. Vazio: o link não aparece.
VITE_POLITICA_PRIVACIDADE_URL=
